# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Postgres (Supabase): the pooled URL for the app, the direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Groq (AI plans and the coach).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

# The Google web client id (the same as the app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID): checks the
# fresh Google sign-in a Google user confirms with before deleting their account.
GOOGLE_WEB_CLIENT_ID=

# Firebase Admin: these three, or FIREBASE_SERVICE_ACCOUNT (JSON or base64 JSON),
# or GOOGLE_APPLICATION_CREDENTIALS. Keep the private key's \n as written.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Header x-admin-key for /api/admin. Generate one: openssl rand -hex 32
ADMIN_SECRET_KEY=

# Per user, per hour. Generating a plan and "next week" share the first limit.
MAX_PLAN_GENERATIONS_PER_HOUR=5
MAX_PLAN_CHATS_PER_HOUR=30

# The in-app update prompt (utils/appRelease.js) reads the latest GitHub release of
# APP_RELEASES_REPO (public; its tag is the version, its .apk the download, its bold bullet
# points "What's new"). Older apps are offered the update, then must update
# APP_UPDATE_GRACE_DAYS (default 3) after it was published; APP_MIN_VERSION makes anything
# older update at once.
# GITHUB_TOKEN: set it on Render. Without it GitHub allows 60 questions an hour per address,
# and Render's addresses are shared, so GitHub refuses (403) and no update is announced. A
# fine-grained token with "Public repositories (read-only)" and no permissions is enough.
GITHUB_TOKEN=
# APP_RELEASES_REPO=pushpanathDev/Iron_Arc-app
# APP_UPDATE_GRACE_DAYS=3
# APP_MIN_VERSION=
# Manual control instead of GitHub (setting APP_LATEST_VERSION switches GitHub off; notes: "|" between lines):
# APP_LATEST_VERSION=2.1.0
# APP_DOWNLOAD_URL=https://github.com/pushpanathDev/Iron_Arc-app/releases/download/v2.1.0/Iron-Arc-2.1.0.apk
# APP_RELEASED_AT=2026-11-10
# APP_RELEASE_NOTES=Iron Arc Pro|Bigger exercise list

# Iron Arc Pro: "off" opens the coach chat and new plans to everyone, free or not.
# Default on. Not set on Render.
# PRO_GATE=off

# Email (Resend, services/emailService.js): the welcome email, and Pro's welcome (with its
# receipt), trial-ending, renewal and cancellation emails. Without the key or sender nothing is sent. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Iron Arc <pro@mail.example.com>
EMAIL_REPLY_TO=
# The logo at the top of every email: an https address mail apps can load. The backend
# serves one at /static/email-logo.png; a copy on an always-on website is more reliable.
# EMAIL_LOGO_URL=https://iron-arc-backend-v2.onrender.com/static/email-logo.png

# One free trial per person: the key for the email fingerprints kept after an
# account is deleted (only a hash, never the email). Generate: openssl rand -hex 32
TRIAL_CLAIM_SECRET=

# Testing only: let "next week" start before its Monday. It becomes this week, and
# the week before is treated as last week. Never on Render.
# ALLOW_EARLY_NEXT_WEEK=true
