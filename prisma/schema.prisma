generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique @map("firebase_uid")
  email         String   @unique
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  authProvider  String?  @map("auth_provider")
  height        Float?
  weight        Float?
  age           Int?
  fitnessGoal   String?  @map("fitness_goal")
  weeklyGoal    Int      @default(4) @map("weekly_goal")
  /// Optional target body weight in kg, set by the user (null = no goal).
  targetWeight  Float?   @map("target_weight")
  /// Training profile, asked once at onboarding (all optional for older accounts).
  /// beginner | intermediate | advanced
  experienceLevel String? @map("experience_level")
  /// full_gym | dumbbells | bodyweight
  equipment       String?
  /// 30 | 45 | 60 | 90
  sessionMinutes  Int?    @map("session_minutes")
  /// ISO weekdays the user trains on, 1 = Monday … 7 = Sunday (max 6). weeklyGoal mirrors its length.
  trainingDays    Int[]   @default([]) @map("training_days")
  /// Areas to go easy on: knees | lower_back | shoulders | wrists
  avoidAreas      String[] @default([]) @map("avoid_areas")
  /// The AI coach's health check (utils/healthCheck.js): { version, answers: { heart: false, … },
  /// checkedAt, consentedAt }. Yes/no answers only; any "yes" turns on Safe mode. Null until done.
  healthCheck     Json?   @map("health_check")
  isAdmin       Boolean  @default(false) @map("is_admin")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workouts        Workout[]
  bodyWeights     BodyWeight[]
  achievements    Achievement[]
  customExercises CustomExercise[]
  plans           Plan[]
  planGenerations PlanGeneration[]
  aiUsage         AiUsage[]
  aiReports       AiReport[]
  aiFeedback      AiFeedback[]

  @@map("users")
}

/// AI calls and tokens per user per UTC day: what the daily budgets check (services/aiBudget.js).
model AiUsage {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  /// The UTC day, "YYYY-MM-DD".
  day       String
  calls     Int    @default(0)
  tokensIn  Int    @default(0) @map("tokens_in")
  tokensOut Int    @default(0) @map("tokens_out")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("ai_usage")
}

/// A coach message a user reported from the app (Google Play requires in-app
/// reporting of AI content). A copy of the message is kept: the chat can change.
model AiReport {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// The plan whose chat held the message (no foreign key: plans can be deleted).
  planId    String   @map("plan_id")
  /// The message's timestamp in that chat.
  messageAt String   @map("message_at")
  content   String
  /// harmful | wrong | offensive | other
  reason    String
  note      String?
  /// open | reviewed
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, messageAt])
  @@index([status, createdAt])
  @@map("ai_reports")
}

/// A thumbs up or down on a coach reply, from the app: how the coach does with real users.
/// A copy of the reply is kept (the chat can change). One per reply; changing it updates the row.
model AiFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// The plan whose chat held the reply (no foreign key: plans can be deleted).
  planId    String   @map("plan_id")
  /// The reply's timestamp in that chat.
  messageAt String   @map("message_at")
  content   String
  /// chat | swap | nextWeek | safety
  kind      String   @default("chat")
  /// up | down
  rating    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, messageAt])
  @@index([createdAt])
  @@map("ai_feedback")
}

// Append-only log of AI plan generations (plans themselves can be deleted).
// Drives the "plans generated" achievements.
model PlanGeneration {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_generations")
}

model Plan {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @default("My Plan")
  criteria    Json?
  /// The plan itself, plus the coach chat (_chatHistory) so no extra table is needed.
  planData    Json     @map("plan_data")
  isActive    Boolean  @default(false) @map("is_active")
  weekNumber  Int      @default(1) @map("week_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("plans")
}

model Workout {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  exercise  String
  category  String
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId, date])
  @@index([userId, category])
  @@map("workouts")
}

model WorkoutSet {
  id        String @id @default(uuid())
  workoutId String @map("workout_id")
  setNumber Int    @map("set_number")
  reps      Int
  weight    Float  @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@map("workout_sets")
}

model BodyWeight {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  weekStart DateTime? @db.Date @map("week_start")
  weight    Float
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("body_weights")
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeKey   String   @map("badge_key")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@map("achievements")
}

model CustomExercise {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, name])
  @@map("custom_exercises")
}
