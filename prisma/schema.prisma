generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique @map("firebase_uid")
  email         String   @unique
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  authProvider  String?  @map("auth_provider")
  height        Float?
  weight        Float?
  age           Int?
  fitnessGoal   String?  @map("fitness_goal")
  weeklyGoal    Int      @default(4) @map("weekly_goal")
  activePlan    Json?    @map("active_plan")
  isAdmin       Boolean  @default(false) @map("is_admin")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workouts        Workout[]
  bodyWeights     BodyWeight[]
  achievements    Achievement[]
  customExercises CustomExercise[]
  plans           Plan[]

  @@map("users")
}

model Plan {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @default("My Plan")
  criteria    Json?
  planData    Json     @map("plan_data")
  chatHistory Json?    @map("chat_history")
  isActive    Boolean  @default(false) @map("is_active")
  weekNumber  Int      @default(1) @map("week_number")
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("plans")
}

model Workout {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  exercise  String
  category  String
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId, date])
  @@index([userId, category])
  @@map("workouts")
}

model WorkoutSet {
  id        String @id @default(uuid())
  workoutId String @map("workout_id")
  setNumber Int    @map("set_number")
  reps      Int
  weight    Float  @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@map("workout_sets")
}

model BodyWeight {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  date      DateTime  @db.Date
  weekStart DateTime? @db.Date @map("week_start")
  weight    Float
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("body_weights")
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeKey   String   @map("badge_key")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
  @@map("achievements")
}

model CustomExercise {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, name])
  @@index([userId, category])
  @@map("custom_exercises")
}
