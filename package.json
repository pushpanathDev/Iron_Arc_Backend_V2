{
  "name": "iron-arc-backend",
  "version": "1.0.0",
  "description": "Backend server for Iron Arc fitness app — Groq planning engine and Firebase Admin",
  "main": "src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "postinstall": "npx prisma generate",
    "test": "node src/utils/achievementEvaluator.test.js && node src/routes/workoutBatch.test.js && node src/services/targetWeight.test.js && node src/services/trainingProfile.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
